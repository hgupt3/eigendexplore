+def _terminal_execution_steps(
+    *, sim_step: int, max_sim_steps: int, ctrl_steps: int
+) -> int:
+    """Return the exact executable prefix of an already-optimized plan."""
+
+    if sim_step < 0 or max_sim_steps <= 0 or ctrl_steps <= 0:
+        raise ValueError("terminal execution bounds must be positive")
+    remaining = max_sim_steps - sim_step
+    if remaining <= 0:
+        return 0
+    return min(ctrl_steps, remaining)
+
+
+def _aggregate_run_info(info_list: list[dict]) -> dict[str, np.ndarray]:
+    """Stack optimizer state traces and concatenate variable execution blocks."""
+
+    if not info_list:
+        return {}
+    keys = set(info_list[0])
+    if any(set(info) != keys for info in info_list[1:]):
+        raise ValueError("per-commit run info keys differ")
+    aggregated: dict[str, np.ndarray] = {}
+    for key in sorted(keys):
+        values = [np.asarray(info[key]) for info in info_list]
+        aggregated[key] = (
+            np.concatenate(values, axis=0)
+            if key in _EXECUTION_TRACE_KEYS
+            else np.stack(values, axis=0)
+        )
+    return aggregated
+
+
+def _executed_physics_cost_summary(
+    info_list: list[dict], *, max_sim_steps: int
+) -> dict[str, object]:
+    """Summarize stock reward terms over the exact executed episode."""
+
+    costs = np.concatenate(
+        [np.asarray(info["executed_physics_cost"], dtype=np.float64) for info in info_list]
+    )
+    rewards = np.concatenate(
+        [
+            np.asarray(info["executed_physics_reward"], dtype=np.float64)
+            for info in info_list
+        ]
+    )
+    reference_indices = np.concatenate(
+        [
+            np.asarray(info["executed_reference_index"], dtype=np.int64)
+            for info in info_list
+        ]
+    )
+    expected_indices = np.arange(1, max_sim_steps + 1, dtype=np.int64)
+    if (
+        costs.shape != (max_sim_steps,)
+        or rewards.shape != (max_sim_steps,)
+        or not np.array_equal(reference_indices, expected_indices)
+        or not np.isfinite(costs).all()
+        or not np.isfinite(rewards).all()
+        or not np.allclose(costs, -rewards, rtol=0.0, atol=1.0e-12)
+    ):
+        raise ValueError("executed full-episode physics-cost trace is inconsistent")
+    return {
+        "final_full_physics_cost": float(costs.mean()),
+        "final_full_physics_cost_sum": float(costs.sum()),
+        "final_full_physics_cost_aggregation": (
