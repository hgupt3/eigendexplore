+def evaluate_control_center(rollout, config, env, ctrls, ref_slice, env_params):
+    costs = []
+    for env_param in env_params:
+        samples = ctrls.unsqueeze(0).expand(config.num_samples, -1, -1).clone()
+        _, rewards, _, info = rollout(config, env, samples, ref_slice, env_param)
+        finite = torch.isfinite(rewards)
+        # Original validity mask also includes physical object errors. With the
+        # stock reward, nonfinite pose differences already make reward nonfinite.
+        if int((~finite).sum()) > max(1, config.num_samples // 100):
+            raise ValueError("center evaluation exceeded nonfinite-world budget")
+        values = rewards[finite].sort().values
+        mid = len(values) // 2
+        median = (
+            values[mid] if len(values) % 2 else 0.5 * (values[mid - 1] + values[mid])
+        )
+        costs.append(-float(median))
+    return max(costs)
+
