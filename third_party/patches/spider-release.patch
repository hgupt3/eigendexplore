+def free_joint_quaternion_slices(model: mujoco.MjModel) -> tuple[slice, ...]:
+    """Return the qpos quaternion slice for every free joint in ``model``."""
+    slices = []
+    for joint_id in range(model.njnt):
+        if model.jnt_type[joint_id] != mujoco.mjtJoint.mjJNT_FREE:
+            continue
+        qpos_address = int(model.jnt_qposadr[joint_id])
+        slices.append(slice(qpos_address + 3, qpos_address + 7))
+    return tuple(slices)
+
+
+def validate_free_joint_qpos_numpy(
+    qpos: np.ndarray,
+    model: mujoco.MjModel,
+    *,
+    context: str,
+    tolerance: float = 1e-6,
+) -> None:
+    """Fail unless every free-joint quaternion is unit and sign-continuous."""
+    values = np.asarray(qpos)
+    if values.ndim != 2 or values.shape[1] != model.nq:
+        raise ValueError(
+            f"{context} qpos must have shape (T, {model.nq}), got {values.shape}"
+        )
+    if not np.isfinite(values).all():
+        raise ValueError(f"{context} qpos contains non-finite values")
+    if not np.isfinite(tolerance) or tolerance <= 0.0:
+        raise ValueError("quaternion validation tolerance must be positive and finite")
+
+    for quat_slice in free_joint_quaternion_slices(model):
+        quaternions = values[:, quat_slice]
+        norm_error = np.abs(np.linalg.norm(quaternions, axis=1) - 1.0)
+        if np.any(norm_error > tolerance):
+            raise ValueError(
+                f"{context} contains a non-unit free-joint quaternion "
+                f"(max norm error {float(norm_error.max()):.3g})"
+            )
+        if len(quaternions) > 1:
+            adjacent_dots = np.sum(quaternions[1:] * quaternions[:-1], axis=1)
+            if np.any(adjacent_dots < -tolerance):
+                raise ValueError(
+                    f"{context} contains an antipodal free-joint transition "
+                    f"(minimum adjacent dot {float(adjacent_dots.min()):.3g})"
+                )
+
+
+def _normalize_unwrap_free_joint_qpos_torch(
+    qpos: torch.Tensor,
+    model: mujoco.MjModel,
+    *,
+    context: str,
+) -> torch.Tensor:
+    if qpos.ndim != 2 or qpos.shape[1] != model.nq:
+        raise ValueError(
+            f"{context} qpos must have shape (T, {model.nq}), got {tuple(qpos.shape)}"
+        )
+    if not bool(torch.isfinite(qpos).all()):
+        raise ValueError(f"{context} qpos contains non-finite values")
+
+    result = qpos.clone()
+    for quat_slice in free_joint_quaternion_slices(model):
+        quaternions = result[:, quat_slice]
+        norms = torch.linalg.vector_norm(quaternions, dim=1)
+        if bool(torch.any(norms <= 1e-12)):
+            raise ValueError(f"{context} contains a zero-norm free-joint quaternion")
+        quaternions = quaternions / norms[:, None]
+        if len(quaternions) > 1:
+            pair_sign = torch.where(
+                torch.sum(quaternions[1:] * quaternions[:-1], dim=1) < 0.0,
+                -torch.ones((), dtype=qpos.dtype, device=qpos.device),
+                torch.ones((), dtype=qpos.dtype, device=qpos.device),
+            )
+            signs = torch.cat(
+                [
+                    torch.ones(1, dtype=qpos.dtype, device=qpos.device),
+                    torch.cumprod(pair_sign, dim=0),
+                ]
+            )
+            quaternions = quaternions * signs[:, None]
+        result[:, quat_slice] = quaternions
+    return result
+
+
+def _validate_free_joint_qpos_torch(
+    qpos: torch.Tensor,
+    model: mujoco.MjModel,
+    *,
+    context: str,
+    tolerance: float = 1e-6,
+) -> None:
+    if qpos.ndim != 2 or qpos.shape[1] != model.nq:
+        raise ValueError(
+            f"{context} qpos must have shape (T, {model.nq}), got {tuple(qpos.shape)}"
+        )
+    if not bool(torch.isfinite(qpos).all()):
+        raise ValueError(f"{context} qpos contains non-finite values")
+    for quat_slice in free_joint_quaternion_slices(model):
+        quaternions = qpos[:, quat_slice]
+        norm_error = torch.abs(torch.linalg.vector_norm(quaternions, dim=1) - 1.0)
+        if bool(torch.any(norm_error > tolerance)):
+            raise ValueError(f"{context} contains a non-unit free-joint quaternion")
+        if len(quaternions) > 1:
+            adjacent_dots = torch.sum(
+                quaternions[1:] * quaternions[:-1], dim=1
+            )
+            if bool(torch.any(adjacent_dots < -tolerance)):
+                raise ValueError(f"{context} contains an antipodal free-joint transition")
+
+
+def interpolate_qpos_shortest_path(
+    qpos: torch.Tensor,
+    factor: int,
+    model: mujoco.MjModel,
+) -> torch.Tensor:
+    """Interpolate qpos with normalized shortest-path free-joint quaternions."""
+    if factor < 1:
+        raise ValueError("qpos interpolation factor must be positive")
+    _validate_free_joint_qpos_torch(qpos, model, context="input reference")
+    interpolated = interp(qpos.unsqueeze(0), factor).squeeze(0)
+    return _normalize_unwrap_free_joint_qpos_torch(
+        interpolated, model, context="interpolated reference"
+    )
