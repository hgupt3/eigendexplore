+def compute_hand_joint_targets(actions, prev_targets, lower_limits, upper_limits, hand_action_transform=None):
+    """Convert policy actions to absolute Allegro joint targets."""
+    if hand_action_transform is None:
+        assert actions.shape[-1] == prev_targets.shape[-1], \
+            "Default hand action scaling requires env.numActions to equal the 16 Allegro hand DoFs"
+        return scale(actions, lower_limits, upper_limits)
+
+    targets = hand_action_transform(actions, prev_targets)
+    assert targets.shape == prev_targets.shape, \
+        "hand_action_transform must return one absolute target per Allegro hand DoF"
+    return targets
+
+def add_latent_state_observation(obs_dims, num_latent_obs):
+    """Add the optional adapter-computed observation to a dict observation layout."""
+    if num_latent_obs < 0:
+        raise ValueError("env.numLatentObs must be non-negative")
+    if num_latent_obs > 0:
+        obs_dims["latent_state"] = num_latent_obs
+    return obs_dims
+
+def compute_latent_observation(
+    hand_dof_pos, hand_prev_targets, num_latent_obs, latent_obs_fn=None
+):
+    """Compute one latent observation from measured hand positions and the
+    previously commanded hand targets, when enabled."""
+    if num_latent_obs == 0:
+        return None
+    if latent_obs_fn is None:
+        raise RuntimeError(
+            "env.numLatentObs > 0 requires self.latent_obs_fn to be set before stepping"
+        )
+    if hand_dof_pos.ndim != 2 or hand_dof_pos.shape[1] != 16:
+        raise ValueError("latent_obs_fn input must have shape (num_envs, 16)")
+    if hand_prev_targets.shape != hand_dof_pos.shape:
+        raise ValueError(
+            "latent_obs_fn previous targets must match measured posture shape"
+        )
+
+    latent_state = latent_obs_fn(hand_dof_pos, hand_prev_targets)
+    if not isinstance(latent_state, Tensor):
+        raise TypeError("latent_obs_fn must return a torch.Tensor")
+    expected_shape = (hand_dof_pos.shape[0], num_latent_obs)
+    if latent_state.shape != expected_shape:
+        raise ValueError(
+            f"latent_obs_fn must return shape {expected_shape}, got {tuple(latent_state.shape)}"
+        )
+    return latent_state
+
