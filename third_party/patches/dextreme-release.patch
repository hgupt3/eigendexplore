new file mode 100644
index 0000000..78b1ad1
--- /dev/null
+++ b/isaacgymenvs/release_bundle.py
@@ -0,0 +1,94 @@
+"""Strict Python 3.8 loader for Action-Bench release target bundles."""
+import json
+from pathlib import Path
+
+import torch
+from rl_games.common.algo_observer import AlgoObserver
+
+
+class TargetBundle:
+    def __init__(self, module, manifest):
+        self.module, self.manifest = module, manifest
+        self.action_dim = manifest['action_dim']
+        self.latent_obs_dim = manifest['latent_obs_dim']
+        self.commanded_target_obs_dim = manifest['commanded_target_obs_dim']
+
+    def decode(self, action, previous):
+        target = self.module.decode(action, previous)
+        self.module.metrics_update(action, previous, target)
+        return target
+
+    def encode_obs(self, measured, previous):
+        latent = self.module.encode_obs(measured)
+        self.module.metrics_update_measured(measured)
+        if self.commanded_target_obs_dim:
+            latent = torch.cat((latent, self.module.commanded_obs(previous)), 1)
+        return latent
+
+    def reset_state(self, indices):
+        self.module.metrics_notify_reset(indices)
+
+    def metrics_flush(self):
+        return self.module.metrics_flush()
+
+
+def load_bundle(env, directory):
+    root = Path(directory)
+    if {p.name for p in root.iterdir()} != {'bundle.pt', 'manifest.json'}:
+        raise ValueError('bundle files differ from release contract')
+    manifest = json.loads((root / 'manifest.json').read_text())
+    keys = {'schema_version', 'format', 'study', 'action_type', 'action_dim',
+            'measured_latent_dim', 'commanded_target_obs_dim', 'latent_obs_dim',
+            'semantics', 'host_joint_names', 'artifact_id', 'num_envs'}
+    if set(manifest) != keys or manifest['schema_version'] != 5 or manifest['format'] != 'action_bench.dextreme.torchscript.v5':
+        raise ValueError('unsupported target bundle schema')
+    if (manifest['action_dim'] != env.num_actions or manifest['latent_obs_dim'] != env.num_latent_obs
+            or manifest['num_envs'] != env.num_envs):
+        raise ValueError('bundle dimensions differ from live environment')
+    actual = env.gym.get_actor_dof_names(env.envs[0], env.allegro_hands[0])
+    if list(actual) != manifest['host_joint_names']:
+        raise ValueError('live joint order differs from target bundle')
+    if env.use_relative_control or getattr(env, 'use_capped_dof_control', False):
+        raise ValueError('target bundles require absolute uncapped host control')
+    for name in ('hand_action_transform', 'latent_obs_fn', 'hand_state_reset_fn'):
+        if getattr(env, name, None) is not None:
+            raise ValueError('refusing to overwrite an existing host hook')
+    module = torch.jit.load(str(root / 'bundle.pt'), map_location=env.dof_pos.device).eval()
+    if module.action_dim != manifest['action_dim'] or module.metrics_num_envs != env.num_envs:
+        raise ValueError('module dimensions differ from manifest')
+    if module.measured_latent_dim != manifest['measured_latent_dim'] or module.commanded_obs_dim != manifest['commanded_target_obs_dim']:
+        raise ValueError('module observation widths differ from manifest')
+    for name, tensor in list(module.named_parameters()) + list(module.named_buffers()):
+        if tensor.device != env.dof_pos.device:
+            raise ValueError('bundle tensor placement differs from host')
+        if tensor.is_floating_point() and not name.startswith('metrics.') and tensor.dtype != env.dof_pos.dtype:
+            raise ValueError('bundle dtype differs from host')
+    delta = manifest['action_type'] in ('joint_delta', 'eigen_delta_joint_delta')
+    if manifest['semantics'] != ('delta' if delta else 'absolute'):
+        raise ValueError('manifest action semantics differ from method')
+    if manifest['latent_obs_dim'] != module.measured_latent_dim + module.commanded_obs_dim:
+        raise ValueError('total observation width differs from module')
+    if manifest['study']['benchmark'] != 'dextreme' or manifest['study']['hand'] != 'allegro':
+        raise ValueError('study does not match the DeXtreme hand')
+    loaded = TargetBundle(module, manifest)
+    env.hand_action_transform = loaded.decode
+    env.latent_obs_fn = loaded.encode_obs if loaded.latent_obs_dim else None
+    env.hand_state_reset_fn = loaded.reset_state
+    env.hand_actions_are_deltas = manifest['semantics'] == 'delta'
+    env.actionbench_bundle = loaded
+    return loaded
+
+
+class MetricsObserver(AlgoObserver):
+    """Write scalar diagnostics; full tensor statistics remain on the bundle."""
+    def after_init(self, algo):
+        self.bundle = algo.vec_env.env.actionbench_bundle
+        self.writer = algo.writer
+
+    def after_print_stats(self, frame, epoch_num, total_time):
+        metrics = self.bundle.metrics_flush()
+        entries = [(key, value) for key, value in metrics.items() if value.numel() == 1]
+        if entries:
+            values = torch.stack([value.reshape(()) for _, value in entries]).cpu().tolist()
+            for (key, _), value in zip(entries, values):
+                self.writer.add_scalar(key, value, frame)
