@@ -0,0 +1,98 @@
+"""Optional state recording through the shared Python 3.8 capture modules."""
+import importlib.util
+import os
+from pathlib import Path
+import sys
+
+import torch
+from rl_games.common.algo_observer import AlgoObserver
+
+
+def recording_modules():
+    root = Path(os.environ['ACTION_BENCH_RECORDING_MODULES'])
+    name = '_action_bench_recording'
+    if name not in sys.modules:
+        spec = importlib.util.spec_from_file_location(
+            name, root / '__init__.py', submodule_search_locations=[str(root)])
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[name] = module
+        spec.loader.exec_module(module)
+    from _action_bench_recording.capture import TrainingStateCapture
+    from _action_bench_recording.observer import StateCaptureObserver
+    return TrainingStateCapture, StateCaptureObserver
+
+
+def capture_rows(task, robot_scale):
+    def pose(value):
+        return torch.cat((value[:3], value[6:7], value[3:6]))
+    return {
+        'joint_pos_allegro': task.dof_pos[0],
+        'joint_target_allegro': task.cur_targets[0],
+        'object_pose': pose(task.object_pose[0]),
+        'goal_pose': pose(task.goal_pose[0]),
+        'reset': task.reset_buf[0].bool(),
+        'action': task.actions[0],
+        'object_scale': task.cube_random_params[0, 0].expand(3),
+        'robot_scale_allegro': robot_scale,
+    }
+
+
+def build_capture(task, output):
+    Capture, _ = recording_modules()
+    control_dt = float(task.dt) * int(task.control_freq_inv)
+    specs = {'joint_pos_allegro': (task.num_hand_dofs,),
+             'joint_target_allegro': (task.num_hand_dofs,), 'object_pose': (7,),
+             'goal_pose': (7,), 'reset': (), 'action': (task.num_actions,),
+             'object_scale': (3,), 'robot_scale_allegro': (3,)}
+    base = task.hand_start_states[0, :7].detach().cpu().tolist()
+    assets = task.cfg['env']['asset']
+    def asset(path):
+        return {'host_repo': 'isaacgymenvs', 'relative_path': 'assets/' + path}
+    template = {
+        'schema_version': 1, 'format': 'action_bench.capture.v1',
+        'benchmark': 'dextreme', 'experiment_id': Path(output).parent.name,
+        'control_dt': control_dt, 'wandb': {'project': '', 'run_id': ''},
+        'robots': [{'name': 'allegro', 'asset': asset(assets['assetFileName']),
+                    'joint_names': list(task.gym.get_actor_dof_names(task.envs[0], task.allegro_hands[0])),
+                    'base_pose': base[:3] + [base[6]] + base[3:6]}],
+        'objects': [{'name': 'cube', 'asset': asset(assets['assetFileNameBlock']),
+                     'scale': None, 'articulated': False}],
+        'channels': {name: {'shape': list(shape), 'dtype': 'bool' if name == 'reset' else 'float32'}
+                     for name, shape in specs.items()},
+        'extras_meta': {'quaternion_convention': 'wxyz'},
+    }
+    return Capture(specs, {'reset': torch.bool}, round(30 / control_dt),
+                   round(15 / control_dt), template, output, task.dof_pos.device)
+
+
+class RecordingObserver(AlgoObserver):
+    def __init__(self):
+        self.capture = None
+        self.task = None
+
+    def after_init(self, algo):
+        _, Observer = recording_modules()
+        self.task = algo.vec_env.env
+        self.capture = build_capture(self.task, os.environ['ACTION_BENCH_RECORD_DIR'])
+        schedule = [{'every_epochs': 60, 'through_epoch': 380},
+                    {'every_epochs': 130, 'through_epoch': None}]
+        self.observer = Observer(self.capture, schedule, AlgoObserver())
+        scale = self.task.gym.get_actor_scale(self.task.envs[0], self.task.allegro_hands[0])
+        self.robot_scale = self.task.dof_pos.new_full((3,), scale)
+        self.observer.after_init(algo)
+        self.original_step = self.task.post_physics_step
+        def step():
+            result = self.original_step()
+            if self.capture.active:
+                self.capture.append(capture_rows(self.task, self.robot_scale))
+            return result
+        self.task.post_physics_step = step
+
+    def after_print_stats(self, frame, epoch_num, total_time):
+        self.observer.after_print_stats(frame, epoch_num, total_time)
+
+    def close(self):
+        if self.capture is not None:
+            if hasattr(self, 'original_step'):
+                self.task.post_physics_step = self.original_step
+            self.capture.close(timeout=60)
